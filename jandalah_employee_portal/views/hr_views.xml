    <!-- Auto-sync validated leaves to attendance records on module install / update -->
    <function model="hr.attendance" name="sync_all_validated_leaves"/>

    <!-- Inherit Leave Form: Allow HR Officers to directly validate from confirm state -->
    <record id="hr_leave_view_form_inherit_direct_validate" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.direct.validate</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="اعتماد الموارد البشرية (مباشر)" name="action_validate" type="object" 
                        class="btn-success" 
                        groups="hr_holidays.group_hr_holidays_user" 
                        invisible="state != 'confirm'"/>
            </xpath>
        </field>
    </record>

    <!-- Working Schedule Attendance Tree Inherit: Duration in Hours -->
    <record id="view_resource_calendar_attendance_tree_inherit_duration" model="ir.ui.view">
        <field name="name">resource.calendar.attendance.tree.inherit.duration</field>
        <field name="model">resource.calendar.attendance</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hour_to']" position="after">
                <field name="duration_hours" widget="float_time" sum="إجمالي الساعات"/>
            </xpath>
        </field>
    </record>

</odoo>
