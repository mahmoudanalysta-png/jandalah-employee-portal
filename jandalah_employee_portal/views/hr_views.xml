<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HR Employee Form Inherit: Geofencing Coordinates & Assets Tab -->
    <record id="view_employee_form_inherit_geofence" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.geofence</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <!-- 1. Geofencing Tab -->
                <page string="النطاق الجغرافي للحضور (Geofencing)" name="geofencing_settings" groups="hr.group_hr_user">
                    <group string="إعدادات الموقع المعتمد لتسجيل الحضور">
                        <group string="طبيعة العمل ونطاق السماح">
                            <field name="geofence_type"/>
                            <field name="work_radius_meters"/>
                        </group>
                        <group string="موقع العمل الأول (خرائط جوجل)">
                            <field name="google_maps_url" widget="url" placeholder="الصق رابط موقع جوجل ماب هنا (مثل: https://maps.app.goo.gl/... أو 24.7136, 46.6753)"/>
                            <field name="work_latitude" invisible="1"/>
                            <field name="work_longitude" invisible="1"/>
                        </group>
                        <group string="موقع العمل الثاني (خرائط جوجل - اختياري)">
                            <field name="google_maps_url_2" widget="url" placeholder="الصق رابط الموقع الثاني من خرائط جوجل إن وجد"/>
                            <field name="work_latitude_2" invisible="1"/>
                            <field name="work_longitude_2" invisible="1"/>
                        </group>
                    </group>
                </page>

                <!-- 2. Custody & Assets Tab -->
                <page string="العهد ومستلزمات العمل" name="assets_tab" groups="hr.group_hr_user">
                    <field name="asset_ids">
                        <list string="العهد ومستلزمات العمل" editable="bottom">
                            <field name="name"/>
                            <field name="category_id" options="{'no_create_edit': False}"/>
                            <field name="asset_code"/>
                            <field name="handover_date"/>
                            <field name="return_date"/>
                            <field name="attachment_name" column_invisible="True"/>
                            <field name="attachment_file" filename="attachment_name" string="المرفق الرسمي"/>
                            <field name="state" widget="badge" 
                                   decoration-warning="state == 'assigned'" 
                                   decoration-info="state == 'return_requested'" 
                                   decoration-success="state == 'acknowledged'" 
                                   decoration-muted="state == 'returned'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Attendance Form Inherit: Distance and Geofence Status -->
    <record id="hr_attendance_view_form_inherit_geofence" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.geofence</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="company_id" readonly="1" options="{'no_open': True}"/>
            </xpath>
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="distance_from_work"/>
                <field name="is_outside_geofence"/>
            </xpath>
        </field>
    </record>

    <!-- HR Attendance List Inherit: Jehat Comprehensive Attendance Columns (Matching 17 Columns Blueprint) -->
    <record id="view_attendance_tree_inherit_jehat" model="ir.ui.view">
        <field name="name">hr.attendance.list.inherit.jehat</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- 1. Employee header translated -->
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="string">الموظف</attribute>
            </xpath>

            <!-- 2. Date column & Leave / Permission status badge -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="company_id" string="الشركة" optional="show"/>
                <field name="attendance_date" string="التاريخ"/>
                <field name="leave_permission_display" string="إجازة / إذن" widget="badge" 
                       decoration-info="leave_permission_display != '-'" 
                       decoration-muted="leave_permission_display == '-'"/>
            </xpath>

            <!-- 3. Check-In: Replace standard check_in with check_in_time and in_location_state -->
            <xpath expr="//field[@name='check_in']" position="replace">
                <field name="check_in_time" string="وقت الحضور"/>
                <field name="in_location_state" widget="badge" 
                       decoration-success="in_location_state == 'approved'" 
                       decoration-danger="in_location_state == 'rejected'" 
                       decoration-muted="in_location_state == 'none'" 
                       string="مكان الحضور"/>
            </xpath>

            <!-- 4. Check-Out: Replace standard check_out with check_out_time, out_location_state and Jehat report columns -->
            <xpath expr="//field[@name='check_out']" position="replace">
                <field name="check_out_time" string="وقت الانصراف"/>
                <field name="out_location_state" widget="badge" 
                       decoration-success="out_location_state == 'approved'" 
                       decoration-danger="out_location_state == 'rejected'" 
                       decoration-muted="out_location_state == 'none'" 
                       string="مكان الانصراف"/>
                <field name="break_duration" string="الاستراحة" optional="show"/>
                <field name="overtime_display" string="وقت إضافي"/>
                <field name="morning_delay_minutes" invisible="1"/>
                <field name="is_leave_day" invisible="1"/>
                <field name="leave_id" invisible="1"/>
                <field name="delay_display" string="تأخير" widget="badge"
                       decoration-danger="morning_delay_minutes &gt; 0 or (delay_display != 'على الموعد' and delay_display != '-')" 
                       decoration-success="delay_display == 'على الموعد'"
                       decoration-muted="delay_display == '-'"/>
                <field name="absence_deduction" string="خصم الغياب" sum="إجمالي خصم الغياب"/>
                <field name="late_deduction" string="خصم التأخير" sum="إجمالي خصم التأخير"/>
                <field name="missing_checkout_deduction" string="خصم الانصراف" sum="إجمالي خصم الانصراف"/>
                <field name="other_deductions" string="خصومات أخرى" sum="إجمالي خصومات أخرى" optional="hide"/>
                <field name="bonus_amount" string="مكافأة" sum="إجمالي المكافآت" optional="hide"/>
                <field name="net_deduction" string="صافي" sum="صافي التأثير" decoration-danger="net_deduction &gt; 0"/>
                <field name="occupancy_rate" string="نسبة الإشغال %" decoration-danger="occupancy_rate == 0" decoration-success="occupancy_rate == 100"/>
                <field name="attendance_notes" string="ملاحظات" optional="show"/>
            </xpath>

            <!-- 5. Hide standard worked hours to preserve exact Jehat table look (still togglable via optional) -->
            <xpath expr="//field[@name='worked_hours']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- ==================== 1. Announcements Views ==================== -->
    <record id="view_jandalah_announcement_tree" model="ir.ui.view">
        <field name="name">jandalah.announcement.tree</field>
        <field name="model">jandalah.announcement</field>
        <field name="arch" type="xml">
            <list string="التعاميم والقرارات الإدارية">
                <field name="date"/>
                <field name="name"/>
                <field name="issued_by_user_id"/>
                <field name="type_id"/>
                <field name="target_type"/>
                <field name="company_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="ack_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_jandalah_announcement_form" model="ir.ui.view">
        <field name="name">jandalah.announcement.form</field>
        <field name="model">jandalah.announcement</field>
        <field name="arch" type="xml">
            <form string="تعميم أو قرار إداري">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="عنوان التعميم / القرار"/>
                        <h1><field name="name" placeholder="مثال: تعميم مواعيد الدوام لشهر رمضان المبارك"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create_edit': False}"/>
                            <field name="issued_by_user_id" options="{'no_create_edit': True}"/>
                            <field name="date"/>
                            <field name="attachment_name" invisible="1"/>
                            <field name="attachment_file" filename="attachment_name" string="المرفق الرسمي (PDF / صورة)"/>
                        </group>
                        <group>
                            <field name="target_type"/>
                            <field name="company_id" invisible="target_type not in ('company', 'department')"/>
                            <field name="department_id" invisible="target_type != 'department'"/>
                            <field name="employee_ids" widget="many2many_tags" invisible="target_type != 'employees'"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="نص التعميم / القرار">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="سجل إقرارات الاطلاع للموظفين">
                            <field name="ack_ids" readonly="1">
                                <list string="إقرارات الاطلاع">
                                    <field name="employee_id"/>
                                    <field name="ack_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jandalah_announcements" model="ir.actions.act_window">
        <field name="name">التعاميم والقرارات</field>
        <field name="res_model">jandalah.announcement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                أنشئ أول تعميم إداري أو خطاب رسمي ليظهر فوراً في بوابة الموظفين مع إشعار بالاطلاع.
            </p>
        </field>
    </record>

    <!-- ==================== 2. Penalties Views ==================== -->
    <record id="view_jandalah_penalty_tree" model="ir.ui.view">
        <field name="name">jandalah.hr.penalty.tree</field>
        <field name="model">jandalah.hr.penalty</field>
        <field name="arch" type="xml">
            <list string="الجزاءات والتحقيقات الإدارية">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="issued_by_user_id"/>
                <field name="type_id"/>
                <field name="date"/>
                <field name="deduction_days" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'issued'" decoration-success="state == 'accepted'" decoration-danger="state == 'objected'" decoration-muted="state == 'closed'"/>
                <field name="employee_response" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_jandalah_penalty_form" model="ir.ui.view">
        <field name="name">jandalah.hr.penalty.form</field>
        <field name="model">jandalah.hr.penalty</field>
        <field name="arch" type="xml">
            <form string="إجراء جزائي / تحقيق إداري">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="issued,accepted,objected,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="مرجع القرار"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="issued_by_user_id" options="{'no_create_edit': True}"/>
                            <field name="type_id" options="{'no_create_edit': False}"/>
                            <field name="date"/>
                            <field name="deduction_days"/>
                            <field name="attachment_name" invisible="1"/>
                            <field name="attachment_file" filename="attachment_name" string="المستند الرسمي (PDF / صورة)"/>
                        </group>
                        <group>
                            <field name="employee_response" readonly="1"/>
                            <field name="response_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="تفاصيل الإجراء والمخالفة">
                            <field name="reason" placeholder="اكتب تفاصيل المخالفة أو استدعاء التحقيق هنا..."/>
                        </page>
                        <page string="إفادة ورد الموظف" invisible="not employee_response">
                            <group>
                                <field name="employee_comment" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jandalah_penalties" model="ir.actions.act_window">
        <field name="name">الجزاءات والتحقيقات</field>
        <field name="res_model">jandalah.hr.penalty</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== 3. Assets Views ==================== -->
    <record id="view_jandalah_asset_tree" model="ir.ui.view">
        <field name="name">jandalah.hr.asset.tree</field>
        <field name="model">jandalah.hr.asset</field>
        <field name="arch" type="xml">
            <list string="العهد ومستلزمات العمل">
                <field name="name"/>
                <field name="asset_code"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <field name="handover_date"/>
                <field name="return_date"/>
                <field name="state" widget="badge" 
                       decoration-warning="state == 'assigned'" 
                       decoration-info="state == 'return_requested'"
                       decoration-success="state == 'acknowledged'" 
                       decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_jandalah_asset_form" model="ir.ui.view">
        <field name="name">jandalah.hr.asset.form</field>
        <field name="model">jandalah.hr.asset</field>
        <field name="arch" type="xml">
            <form string="عهدة موظف">
                <header>
                    <button name="action_confirm_return" string="تأكيد استرداد العهدة" type="object" class="btn-primary" invisible="state != 'return_requested'"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,acknowledged,return_requested,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="اسم العهدة"/>
                        <h1><field name="name" placeholder="مثال: لابتوب Dell XPS 15 أو سيارة كورولا 2024"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="category_id" options="{'no_create_edit': False}"/>
                            <field name="asset_code"/>
                            <field name="attachment_name" invisible="1"/>
                            <field name="attachment_file" filename="attachment_name" string="المرفق الرسمي للعهدة (PDF / صورة)"/>
                        </group>
                        <group>
                            <field name="handover_date"/>
                            <field name="return_date"/>
                            <field name="ack_date" readonly="1"/>
                            <field name="ack_signature" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="مواصفات وحالة العهدة">
                            <field name="notes" placeholder="ملاحظات الحالة الفنية أو الرقم التسلسلي أو المواصفات..."/>
                        </page>
                        <page string="إفادة واستلام الموظف" invisible="state == 'assigned'">
                            <group>
                                <field name="employee_feedback" readonly="1"/>
                            </group>
                        </page>
                        <page string="تفاصيل وإجراءات الاسترجاع" invisible="state not in ('return_requested', 'returned')">
                            <group>
                                <field name="return_request_date" readonly="1"/>
                                <field name="return_notes" readonly="1"/>
                                <field name="returned_by_user_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jandalah_assets" model="ir.actions.act_window">
        <field name="name">العهد ومستلزمات العمل</field>
        <field name="res_model">jandalah.hr.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== 4. Location Requests Views ==================== -->
    <record id="view_jandalah_location_request_tree" model="ir.ui.view">
        <field name="name">jandalah.location.request.tree</field>
        <field name="model">jandalah.location.request</field>
        <field name="arch" type="xml">
            <list string="طلبات العمل من موقع مؤقت">
                <field name="employee_id"/>
                <field name="temp_location_name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="supervisor_id"/>
                <field name="state" widget="badge" decoration-info="state == 'confirm'" decoration-success="state == 'approve'" decoration-danger="state == 'refuse'"/>
            </list>
        </field>
    </record>

    <record id="view_jandalah_location_request_form" model="ir.ui.view">
        <field name="name">jandalah.location.request.form</field>
        <field name="model">jandalah.location.request</field>
        <field name="arch" type="xml">
            <form string="طلب عمل من موقع مؤقت">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="confirm,approve,refuse"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="temp_location_name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="supervisor_id"/>
                            <field name="temp_latitude"/>
                            <field name="temp_longitude"/>
                            <field name="temp_radius_meters"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="السبب والتبرير">
                            <field name="reason"/>
                        </page>
                        <page string="ملاحظات الاعتماد والرفض" invisible="state == 'confirm'">
                            <group>
                                <field name="action_date" readonly="1"/>
                                <field name="refusal_reason" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jandalah_location_requests" model="ir.actions.act_window">
        <field name="name">طلبات المواقع المؤقتة</field>
        <field name="res_model">jandalah.location.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== 5. Dynamic Models Views (Types & Categories) ==================== -->
    <!-- Announcement Types -->
    <record id="view_jandalah_announcement_type_tree" model="ir.ui.view">
        <field name="name">jandalah.announcement.type.tree</field>
        <field name="model">jandalah.announcement.type</field>
        <field name="arch" type="xml">
            <list string="أنواع التعاميم والإشعارات" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_jandalah_announcement_types" model="ir.actions.act_window">
        <field name="name">أنواع التعاميم والإشعارات</field>
        <field name="res_model">jandalah.announcement.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Penalty Types -->
    <record id="view_jandalah_penalty_type_tree" model="ir.ui.view">
        <field name="name">jandalah.hr.penalty.type.tree</field>
        <field name="model">jandalah.hr.penalty.type</field>
        <field name="arch" type="xml">
            <list string="أنواع الجزاءات والتحقيقات" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_jandalah_penalty_types" model="ir.actions.act_window">
        <field name="name">أنواع الجزاءات والتحقيقات</field>
        <field name="res_model">jandalah.hr.penalty.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Asset Categories -->
    <record id="view_jandalah_asset_category_tree" model="ir.ui.view">
        <field name="name">jandalah.hr.asset.category.tree</field>
        <field name="model">jandalah.hr.asset.category</field>
        <field name="arch" type="xml">
            <list string="تصنيفات العهد ومستلزمات العمل" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_jandalah_asset_categories" model="ir.actions.act_window">
        <field name="name">تصنيفات العهد ومستلزمات العمل</field>
        <field name="res_model">jandalah.hr.asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Push Notification Subscribers Views ==================== -->
    <record id="view_jandalah_push_subscriber_list" model="ir.ui.view">
        <field name="name">jandalah.push.subscriber.list</field>
        <field name="model">jandalah.push.subscriber</field>
        <field name="arch" type="xml">
            <list string="مشتركو إشعارات الهاتف المنبثقة">
                <field name="employee_id"/>
                <field name="device_name"/>
                <field name="endpoint"/>
                <field name="last_seen"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_jandalah_push_subscribers" model="ir.actions.act_window">
        <field name="name">مشتركو إشعارات الهاتف</field>
        <field name="res_model">jandalah.push.subscriber</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Menus ==================== -->
    <menuitem id="menu_jandalah_hr_portal_management"
              name="بوابة الخدمات الذاتية"
              parent="hr.menu_hr_root"
              sequence="25"
              groups="hr.group_hr_user"/>

    <menuitem id="menu_jandalah_announcements_sub"
              name="التعاميم والقرارات"
              parent="menu_jandalah_hr_portal_management"
              action="action_jandalah_announcements"
              sequence="10"/>

    <menuitem id="menu_jandalah_penalties_sub"
              name="الجزاءات والتحقيقات"
              parent="menu_jandalah_hr_portal_management"
              action="action_jandalah_penalties"
              sequence="20"/>

    <menuitem id="menu_jandalah_assets_sub"
              name="العهد ومستلزمات العمل"
              parent="menu_jandalah_hr_portal_management"
              action="action_jandalah_assets"
              sequence="30"/>

    <menuitem id="menu_jandalah_location_requests_sub"
              name="طلبات المواقع المؤقتة"
              parent="menu_jandalah_hr_portal_management"
              action="action_jandalah_location_requests"
              sequence="40"/>

    <menuitem id="menu_jandalah_push_subscribers_sub"
              name="مشتركو إشعارات الهاتف"
              parent="menu_jandalah_hr_portal_management"
              action="action_jandalah_push_subscribers"
              sequence="50"/>

    <!-- Configuration Menu for Dynamic Types & Categories -->
    <menuitem id="menu_jandalah_configuration_sub"
              name="إعدادات الأنواع والتصنيفات"
              parent="menu_jandalah_hr_portal_management"
              sequence="90"/>

    <menuitem id="menu_jandalah_announcement_types_sub"
              name="أنواع التعاميم والإشعارات"
              parent="menu_jandalah_configuration_sub"
              action="action_jandalah_announcement_types"
              sequence="10"/>

    <menuitem id="menu_jandalah_penalty_types_sub"
              name="أنواع الجزاءات والتحقيقات"
