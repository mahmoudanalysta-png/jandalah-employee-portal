<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_overdue_attendance_reminder" model="ir.cron">
        <field name="name">جندله | تذكير الموظفين بالانصراف التلقائي (Web Push)</field>
        <field name="model_id" ref="model_jandalah_push_subscriber"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_overdue_attendance()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
